# ==============================================================================
# MarketFlux Frontend Environment Variables
# All public frontend variables must be prefixed with VITE_
# ==============================================================================

# API Base URL (Vite dev proxy forwards /api to backend localhost:8000)
VITE_API_BASE_URL=/api

# Supabase Public Client Credentials (safe for browser client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
